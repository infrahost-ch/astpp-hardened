# Konfiguration fuer install.sh - nach install.conf kopieren und anpassen.
# Pflicht ist nur ASTPP_FQDN, alle anderen Werte sind optional (sonst gelten die Standardwerte).

# Oeffentlicher Hostname (DNS A/AAAA-Eintrag muss auf den Server zeigen)
ASTPP_FQDN="astpp.example.com"

# Fuer Let's Encrypt (Ablaufwarnungen) und fail2ban-Absender/Empfaenger
ADMIN_EMAIL=""

# Betreiber im Firmenprofil (Rechnungen, E-Mails); Adresse, Telefon, UID danach in der
# Oberflaeche unter Configuration / Company Profile ergaenzen. Land wie in Tabelle countrycode.
COMPANY_NAME=""            # z.B. "Beispiel Telecom AG"; leer = Firmenprofil nicht setzen
COMPANY_WEBSITE=""         # z.B. "https://www.example.com"
COMPANY_COUNTRY="SWITZERLAND"

# yes = TLS-Zertifikat via Let's Encrypt (certbot, HTTP-01 ueber Port 80).
# Mit "yes" akzeptieren Sie das Let's Encrypt Subscriber Agreement.
# no  = selbstsigniertes Zertifikat
LETSENCRYPT="yes"

# FreeSWITCH-Installationsart:
#   auto     = packages wenn FS_TOKEN gesetzt, sonst source
#   packages = offizielle SignalWire-Pakete (braucht FS_TOKEN, kostenloses SignalWire-Konto)
#   source   = Build von FreeSWITCH v1.11.x aus dem Quellcode (20-40 Minuten, ohne Token)
FS_INSTALL_METHOD="auto"
FS_TOKEN=""

# SSH: Port (leer = automatisch aus sshd) und optional erlaubte Netze (Leerzeichen-getrennt)
SSH_PORT=""
SSH_ALLOW_CIDRS=""          # z.B. "203.0.113.0/24 2001:db8:1234::/48"

# SIP: wenn die Gegenstellen (Carrier, Kunden-PBX) bekannt sind, hier eintragen.
# Leer = SIP aus dem ganzen Internet erreichbar (mit Rate-Limit + fail2ban).
SIP_ALLOW_CIDRS=""
SIP_TLS="no"                # yes = zusaetzlich 5061/tcp oeffnen
SIP_RATE="60"               # max. SIP-Pakete pro Sekunde und Quell-IP
SIP_BURST="200"

# RTP-Portbereich (wird in FreeSWITCH und Firewall gleich gesetzt)
RTP_START="16384"
RTP_END="32768"

# PHP open_basedir fuer die Weboberflaeche (bei unerklaerlichen Fehlern testweise "no")
PHP_OPEN_BASEDIR="yes"

# ASTPP-Quellbaum (Standard: astpp/ neben astpp-debian13/) und gepruefte FreeSWITCH-Versionen
#ASTPP_TREE="/root/astpp/astpp"
#FS_VERSION="v1.11.3"
