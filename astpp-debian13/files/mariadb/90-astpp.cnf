# ASTPP - managed by astpp-debian13/install.sh
[mysqld]
bind-address                   = 127.0.0.1
skip-name-resolve
local_infile                   = 0

# ASTPP 6 was written for MySQL with a non-strict sql_mode (zero dates, implicit
# conversions). Strict mode breaks inserts all over the application.
sql_mode                       = NO_ENGINE_SUBSTITUTION

# The ASTPP schema uses EVENTs (cdrs_staging -> report tables every minute).
# MariaDB ships with the event scheduler disabled.
event_scheduler                = ON
log_bin_trust_function_creators = 1

# FreeSWITCH (ODBC, up to max-db-handles) + php-fpm pools
max_connections                = 600
wait_timeout                   = 600
interactive_timeout            = 600

character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci

innodb_buffer_pool_size        = @INNODB_BUFFER_POOL@
innodb_log_file_size           = 256M
innodb_flush_method            = O_DIRECT
# keep =1: billing data (balances, CDRs) must survive a crash
innodb_flush_log_at_trx_commit = 1
table_open_cache               = 4000
tmp_table_size                 = 64M
max_heap_table_size            = 64M

slow_query_log                 = 1
slow_query_log_file            = /var/log/mysql/mariadb-slow.log
long_query_time                = 2
