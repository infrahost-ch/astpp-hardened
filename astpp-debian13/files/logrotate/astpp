# managed by astpp-debian13/install.sh
/var/log/astpp/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su www-data www-data
}

/var/log/freeswitch/freeswitch.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su freeswitch freeswitch
}
# nginx logs (astpp_*.log, fs_*.log) are covered by /etc/logrotate.d/nginx.
